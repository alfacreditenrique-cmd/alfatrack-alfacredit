{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/turso", "destination": "/index.html" },
    { "source": "/db", "destination": "/index.html" },
    { "source": "/gestor-db.html", "destination": "/index.html" }
  ]
}
